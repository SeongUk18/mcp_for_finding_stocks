# ============================================
# Trend Scraper MCP — 환경 변수 예시
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 채우세요.
# ============================================

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Naver Search API (developers.naver.com)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 스캔할 유튜브 채널 (JSON 배열, id + name)
# 예: [{"id":"UCxxxxxxxx","name":"채널이름"}, ...]
YOUTUBE_CHANNELS=[{"id":"UCxxxxxxxxxxxxxxxxxxxxxxxxxx","name":"예시채널1"},{"id":"UCyyyyyyyyyyyyyyyyyyyyyyyyyy","name":"예시채널2"}]
