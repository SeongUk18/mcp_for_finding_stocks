# 이 서버는 API 키가 없어도 동작한다. (yfinance + 공개 아카이브)
# 다만 한국투자증권 키를 넣으면 시세 품질이 크게 올라간다:
#   - 무료 실시간 체결가 (yfinance는 당일 일봉이 아예 없음)
#   - 프리마켓·애프터마켓 분봉 (ET 04:00~20:00)
#   - 호가 10단계와 잔량
#   - 상승률·거래량·급등·시가총액 순위 (get_us_market_movers)
#   - 한글 해외 뉴스
#
# mcp-market-data/.env 에 이미 키가 있으면 자동으로 그걸 읽으므로
# 여기에 다시 넣지 않아도 된다.
# KIS_APPKEY=
# KIS_APPSECRET=

# 토큰은 분당 1회만 발급되므로 파일에 캐시해 서버 간 공유한다.
# 기본값: %LOCALAPPDATA%\kis-mcp\token.json
# KIS_TOKEN_CACHE=

# 아래 값들은 기본 동작을 바꾸고 싶을 때만 설정하면 된다.

# 세레니티 아카이브 캐시 유지 시간(초). 기본 3600 = 1시간
# SERENITY_CACHE_TTL_SEC=3600

# 상대강도 비교 벤치마크
# BENCHMARKS=SPY,QQQ

# 아카이브 원본 주소를 직접 바꾸고 싶을 때
# SERENITY_CSV_URL=https://raw.githubusercontent.com/yan-labs/serenity-aleabitoreddit/main/data/aleabitoreddit_tweets.csv
