# 이 서버는 API 키가 없어도 그대로 동작한다. (yfinance + 공개 아카이브)
# 아래 값들은 기본 동작을 바꾸고 싶을 때만 설정하면 된다.

# 세레니티 아카이브 캐시 유지 시간(초). 기본 3600 = 1시간
# SERENITY_CACHE_TTL_SEC=3600

# 상대강도 비교 벤치마크
# BENCHMARKS=SPY,QQQ

# 아카이브 원본 주소를 직접 바꾸고 싶을 때
# SERENITY_CSV_URL=https://raw.githubusercontent.com/yan-labs/serenity-aleabitoreddit/main/data/aleabitoreddit_tweets.csv
